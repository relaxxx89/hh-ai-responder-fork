# Ссылка на поиск вакансий
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=python

# ID резюме (если не указан — используется последнее)
HH_RESUME=

# OpenAI-compatible API
HH_AI_BASE_URL=http://localhost:11434
HH_AI_MODEL=llama3.1:8b
HH_AI_API_KEY=

# AI-фильтр вакансий по резюме: heavy, light или custom; пусто = отключён
HH_AI_FILTER=heavy
HH_AI_FILTER_PROMPT=
HH_AI_FILTER_RATE_LIMIT=40

# Интервал повторной проверки чатов: 30s, 5m, 1h и т.п.
HH_CHAT_INTERVAL=15m
